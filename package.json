{
  "name": "charmblessrental",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "rental-history:extract": "python3 scripts/extract-rental-history.py",
    "rental-history:dry-run": "node --env-file=.env.local scripts/import-rental-history.mjs",
    "rental-history:import": "node --env-file=.env.local scripts/import-rental-history.mjs --commit",
    "products:merge:dry-run": "node --env-file=.env.local scripts/merge-products.mjs",
    "products:merge:commit": "node --env-file=.env.local scripts/merge-products.mjs --commit",
    "prices:import:dry-run": "node --env-file=.env.local scripts/import-image-prices.mjs",
    "prices:import:commit": "node --env-file=.env.local scripts/import-image-prices.mjs --commit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@radix-ui/react-icons": "^1.3.2",
    "jsqr": "1.4.0",
    "mongodb": "^7.7.0",
    "next": "16.4.2",
    "qrcode": "1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
