# Server-only MongoDB credentials. URL-encode special characters in the password.
MONGODB_URI=mongodb://USERNAME:PASSWORD@HOST:27017/charmblessrental?authSource=charmblessrental

# Optional initial owner email. Existing accounts can use their legacy username until an email is added in Admins.
ADMIN_EMAIL=
# An existing admin account is managed at /admin/admins.
# Session signing secret must contain 32+ random characters.
ADMIN_SESSION_SECRET=

# Cloudflare R2 S3 credentials (server-only).
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=charmblessrental
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public URL only. This value is safe to include in browser code.
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-f85d0f916ffe4c5fb86eaf0357525b4e.r2.dev

# LINE Messaging API (Channel secret / long-lived Channel access token)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
